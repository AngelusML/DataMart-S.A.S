AIRFLOW_FERNET_KEY=

# --- Repositorio analítico (Data Warehouse) ---
DW_USER=datamart
DW_PASSWORD=cambia_esto_dw
DW_DB=datamart_dw
# Puerto expuesto en la máquina para conectarte con DBeaver/psql
DW_HOST_PORT=5433
