# --- Base de datos de metadatos de Airflow ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=cambia_esto_airflow
AIRFLOW_DB_NAME=airflow

# --- Usuario administrador de la UI de Airflow (http://localhost:8080) ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambia_esto_admin

# --- Seguridad de Airflow ---
AIRFLOW_WEBSERVER_SECRET_KEY=cambia_esto_por_un_texto_largo_aleatorio
